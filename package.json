{
    "name": "tg-transient",
    "version": "0.1.0",
    "description": "Simple stateless cli tool that send message by Telegram bot api.",
    "keywords": [
        "telegram",
        "cli",
        "stateless",
        "bun"
    ],
    "license": "MIT",
    "author": "LiAlH4",
    "repository": "github:lialh4qwq/tg-transient",
    "homepage": "https://github.com/lialh4qwq/tg-transient",
    "bugs": "https://github.com/lialh4qwq/tg-transient/issues",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "files": [
        "src/**/*",
        "tsconfig.json"
    ],
    "scripts": {
        "build": "rolldown -c",
        "check": "pnpm run check:type && pnpm run check:format && pnpm run check:lint",
        "check:type": "tsc",
        "check:format": "biome check --write --linter-enabled=false",
        "check:lint": "biome lint --write"
    },
    "peerDependencies": {
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "@types/node": "^26.2.0",
        "rolldown": "^1.2.5"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.0-beta.107",
        "effect": "4.0.0-rc.111",
        "grammy": "^1.45.1"
    }
}
